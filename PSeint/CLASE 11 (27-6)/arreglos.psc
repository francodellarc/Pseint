Algoritmo arreglos
	Definir num, contador Como Entero
	Dimensionar num[7]
	Imprimir "Ingrese un número a almacenar: "
	Para contador = 0 Hasta 6 Hacer
		Leer nro
		num[contador] = nro
	FinPara
	Imprimir "La lista contiene: "
	Para contador = 0 Hasta 6 Hacer
		Imprimir Sin Saltar num[contador], " "
	FinPara
FinAlgoritmo